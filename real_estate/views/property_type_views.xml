<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- search -->
    <record id="property_type_view_search" model="ir.ui.view">
        <field name="name">property.type.view.search</field>
        <field name="model">property.type</field>
        <field name="arch" type="xml">
            <search string="">
                
            </search>
        </field>
    </record>
    <!-- form -->
    <record id="property_type_view_form" model="ir.ui.view">
        <field name="name">property.type.view.form</field>
        <field name="model">property.type</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                <!-- Stat button on the right -->
                <header>
                <div class="oe_button_box" name="button_box">
                    <button name="%(property_offer_action)d" type="action" class="oe_stat_button" icon="fa-handshake-o">
                        <field name="offer_count" string="" widget="statinfo"/>
                    </button>
                </div>
</header>
                <!-- Main fields (title/name) -->
                <group>
                    <field name="name" nolabel="1"></field>
                </group>


                        
                        <notebook>
                        <page string="Properties">
                        <field name="property_ids">                       
                            <list>
                                <field name="name"/>
                                <field name="expected_price"/>
                                <field name="state"/>
                            </list>
                         </field>
                        </page>
                        </notebook>
                  
                </sheet>
            </form>
        </field>
    </record>

    <!-- list -->
    <record id="property_type_view_tree" model="ir.ui.view">
        <field name="name">property.type.view.tree</field>
        <field name="model">property.type</field>
        <field name="arch" type="xml">
            <list string="Channel">
                <field name="name"/>
                <field name="sequence" widget="handle"/>
            </list>
        </field>
    </record>


    <record id="property_type_action" model="ir.actions.act_window">
        <field name="name">Property type</field>
        <field name="res_model">property.type</field>
        <field name="view_mode">list,form</field>
    </record>
    
</odoo>
